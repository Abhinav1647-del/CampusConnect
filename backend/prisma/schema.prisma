generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  CLUB_LEAD
  MESS_ADMIN
  CAMPUSCART_MODERATOR
  APP_ADMIN
}

enum MealPeriod {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  CANCELLED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EventRegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}

enum NotificationType {
  EVENT_REGISTRATION
  EVENT_CHANGE
  EVENT_REMINDER
  ANNOUNCEMENT
  CART_REQUEST_UPDATE
  LISTING_STATUS_CHANGE
  GENERAL
}

enum BookmarkType {
  EVENT
  CLUB
  LISTING
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  rollNumber        String?        @unique
  passwordHash      String
  role              Role           @default(STUDENT)
  avatarUrl         String?
  expoPushToken     String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tokens            UserToken[]
  foodRatings       FoodRating[]
  clubMemberships   ClubMembership[]
  eventRegistrations EventRegistration[]
  announcements     Announcement[]
  bookmarks         Bookmark[]
  listings          Listing[]      @relation("SellerListings")
  buyerRequests     ListingRequest[] @relation("BuyerRequests")
  sentMessages      Message[]      @relation("SentMessages")
  notifications     Notification[]
  auditLogs         AuditLog[]
  reviewsGiven      SellerReview[] @relation("ReviewsGiven")
  reviewsReceived   SellerReview[] @relation("ReviewsReceived")
  listingReports    ListingReport[]
  messNotices       MessNotice[]

  @@index([email])
  @@index([role])
}

model UserToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Mess {
  id          String   @id @default(cuid())
  name        String
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  meals       Meal[]
  notices     MessNotice[]
}

model Meal {
  id          String      @id @default(cuid())
  messId      String
  date        DateTime    @db.Date
  period      MealPeriod
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  mess        Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  mealItems   MealMenuItem[]
  ratings     FoodRating[]

  @@unique([messId, date, period])
  @@index([date])
  @@index([messId])
}

model MenuItem {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isVeg       Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  mealItems   MealMenuItem[]
}

model MealMenuItem {
  id         String   @id @default(cuid())
  mealId     String
  menuItemId String
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([mealId, menuItemId])
}

model FoodRating {
  id        String   @id @default(cuid())
  userId    String
  mealId    String
  rating    Int
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([userId, mealId])
  @@index([mealId])
}

model MessNotice {
  id          String   @id @default(cuid())
  messId      String
  authorId    String
  title       String
  content     String
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mess        Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([messId])
}

model Club {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  category    String
  logoUrl     String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  memberships ClubMembership[]
  events      Event[]
  announcements Announcement[]
  bookmarks   Bookmark[]

  @@index([category])
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  isLead    Boolean  @default(false)
  joinedAt  DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model Event {
  id               String              @id @default(cuid())
  clubId           String
  title            String
  description      String?
  posterUrl        String?
  venue            String?
  startTime        DateTime
  endTime          DateTime?
  registrationDeadline DateTime?
  capacity         Int?
  enableWaitlist   Boolean             @default(false)
  isCancelled      Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  club             Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  registrations    EventRegistration[]
  bookmarks        Bookmark[]

  @@index([clubId])
  @@index([startTime])
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(REGISTERED)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([clubId])
}

model Bookmark {
  id           String       @id @default(cuid())
  userId       String
  type         BookmarkType
  eventId      String?
  clubId       String?
  listingId    String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club         Club?        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  listing      Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, type, eventId])
  @@unique([userId, type, clubId])
  @@unique([userId, type, listingId])
  @@index([userId])
}

model Listing {
  id          String          @id @default(cuid())
  sellerId    String
  title       String
  description String?
  price       Decimal         @db.Decimal(10, 2)
  category    String
  condition   ListingCondition
  status      ListingStatus   @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  seller      User            @relation("SellerListings", fields: [sellerId], references: [id])
  images      ListingImage[]
  requests    ListingRequest[]
  transaction Transaction?
  reports     ListingReport[]
  reviews     SellerReview[]
  bookmarks   Bookmark[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([price])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  key       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model ListingRequest {
  id        String        @id @default(cuid())
  listingId String
  buyerId   String
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User          @relation("BuyerRequests", fields: [buyerId], references: [id])
  conversation Conversation?
  transaction  Transaction?

  @@unique([listingId, buyerId])
  @@index([listingId])
  @@index([buyerId])
}

model Conversation {
  id        String    @id @default(cuid())
  requestId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  request   ListingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
}

model Transaction {
  id          String   @id @default(cuid())
  listingId   String   @unique
  requestId   String   @unique
  completedAt DateTime @default(now())
  notes       String?
  listing     Listing  @relation(fields: [listingId], references: [id])
  request     ListingRequest @relation(fields: [requestId], references: [id])
}

model ListingReport {
  id         String       @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id])

  @@index([listingId])
  @@index([status])
}

model SellerReview {
  id          String   @id @default(cuid())
  listingId   String
  reviewerId  String
  sellerId    String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  listing     Listing  @relation(fields: [listingId], references: [id])
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  seller      User     @relation("ReviewsReceived", fields: [sellerId], references: [id])

  @@unique([listingId, reviewerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}
