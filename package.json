{
  "name": "campus-connect-tantra",
  "version": "1.0.0",
  "description": "IIIT Nagpur Campus Connect - Monorepo housing NestJS Backend & Lovable Frontend",
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend/campus-connect-hub-main run dev -- --host",
